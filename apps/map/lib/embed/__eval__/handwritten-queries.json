    { "q": "satellite photos from past years", "expect": ["esri-wayback", "wayback-capture"] },
    { "q": "when was this aerial image taken", "expect": ["wayback-capture"] },
    { "q": "old topographic quadrangle maps", "expect": ["usgs-htmc"] }
  ]
}
