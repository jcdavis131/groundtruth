{
  "kind": "hand-written by the build agent, not user queries",
  "date": "2026-10-16",
  "purpose": "A small report on whether a query finds the right catalogue card (op=search, the palette's Collections group). Not a CI gate and not evidence about real users: the build agent wrote both the queries and the cards they should hit.",
  "queries": [
    { "q": "marshes and swamps", "expect": ["nwi-wetlands", "nwi-wetlands-raster"] },
    { "q": "wetland habitat map", "expect": ["nwi-wetlands", "nwi-wetlands-raster"] },
    { "q": "old buildings with historic significance", "expect": ["nrhp-listed"] },
    { "q": "national historic landmarks", "expect": ["nrhp-listed"] },
    { "q": "endangered species protected habitat", "expect": ["fws-crithab", "nmfs-crithab", "opp-ranges"] },
    { "q": "where salmon and whales are protected", "expect": ["nmfs-crithab"] },
    { "q": "where could a threatened species live", "expect": ["opp-ranges", "fws-crithab", "nmfs-crithab"] },
    { "q": "polluted rivers and lakes", "expect": ["attains-impaired"] },
    { "q": "streams that fail water quality standards", "expect": ["attains-impaired"] },
    { "q": "forever chemicals in tap water", "expect": ["ucmr5-pfas"] },
    { "q": "which utility supplies drinking water here", "expect": ["cws-service-areas"] },
    { "q": "superfund cleanup sites", "expect": ["emef-sems", "npl-boundaries", "npl-status"] },
    { "q": "factories that report toxic emissions", "expect": ["emef-tri", "tri-releases"] },
    { "q": "how many pounds of chemicals a plant released", "expect": ["tri-releases"] },
    { "q": "hazardous waste generators", "expect": ["emef-rcra"] },
    { "q": "abandoned industrial land redevelopment grants", "expect": ["emef-acres"] },
    { "q": "outline of a contaminated site", "expect": ["npl-boundaries"] },
    { "q": "when was a site added to the priorities list", "expect": ["npl-status"] },
    { "q": "old military bases being cleaned up", "expect": ["fuds-properties", "fuds-projects", "fuds-mrs"] },
    { "q": "unexploded ordnance", "expect": ["fuds-mrs"] },
    { "q": "cost to finish cleanup at former army land", "expect": ["fuds-projects"] },
    { "q": "leaking gas station tanks", "expect": ["ust-releases-county"] },
    { "q": "number of underground fuel tanks per county", "expect": ["ust-facilities-county", "ust-releases-county"] },
    { "q": "100-year floodplain", "expect": ["fema-nfhl-zones"] },
