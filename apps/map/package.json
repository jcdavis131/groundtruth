    "data:gas": "node scripts/gas-data.mjs",
    "data:natgas": "node scripts/natgas-data.mjs",
    "data:energy": "node scripts/energy-data.mjs",
    "data:flows": "node scripts/flows-data.mjs",
    "data:ops": "python3 dataops/dataops.py",
    "ml:train": "python3 ml/multitower/train.py",
    "ml:eval": "python3 ml/multitower/evaluate.py",
    "ml:forecast": "python3 ml/multitower/forecast.py"
  },
  "dependencies": {
