{
  "name": "embedding-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs && node scripts/patch-knockout-csp.mjs",
    "predev": "node scripts/copy-cesium.mjs && node scripts/patch-knockout-csp.mjs",
    "dev": "next dev",
