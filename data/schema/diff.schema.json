{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jcdavis131/groundtruth/data/schema/diff.schema.json",
  "title": "groundtruth snapshot diff, version diff/1",
  "description": "What changed between two snapshot days of one collection and region, written by data/pipeline/diff.py. Every removal has one reason: publisher-status, our-rule, id-churn or unknown. validate.mjs adds the checks JSON Schema can't say: the counts agree with the lists, an id appears once, and an id-churn names a replacement that says it replaces the removed id.",
  "type": "object",
  "required": ["schemaVersion", "collection", "region", "generator", "from", "to", "counts", "added", "removed", "changed"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "diff/1" },
    "collection": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "region": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "from": { "$ref": "#/$defs/side" },
    "to": { "$ref": "#/$defs/side" },
    "counts": {
      "type": "object",
      "required": ["added", "removed", "changed", "unchanged", "removedByReason"],
      "additionalProperties": false,
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "removedByReason": {
          "type": "object",
          "required": ["publisher-status", "our-rule", "id-churn", "unknown"],
          "additionalProperties": false,
          "properties": {
            "publisher-status": { "type": "integer", "minimum": 0 },
            "our-rule": { "type": "integer", "minimum": 0 },
            "id-churn": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["new", "id-churn"] },
          "replaces": { "type": "string", "minLength": 1 }
        },
        "allOf": [{ "if": { "properties": { "reason": { "const": "id-churn" } }, "required": ["reason"] }, "then": { "required": ["replaces"] } }]
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["publisher-status", "our-rule", "id-churn", "unknown"] },
          "why": { "type": "string", "minLength": 1 },
          "replacedBy": { "type": "string", "minLength": 1 },
          "secondaryKey": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } }
          },
          "distanceM": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "allOf": [{ "if": { "properties": { "reason": { "const": "id-churn" } }, "required": ["reason"] }, "then": { "required": ["replacedBy", "secondaryKey", "distanceM"] } }]
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": ["snapshotId", "createdAt", "recordCount"],
      "additionalProperties": false,
      "properties": {
        "snapshotId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "minLength": 1 },
        "recordCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
